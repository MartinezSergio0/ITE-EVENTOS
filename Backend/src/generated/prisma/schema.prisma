/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model actividad {
  id                                         BigInt         @id @default(autoincrement())
  evento                                     Int
  nombre                                     String         @db.VarChar(100)
  descripcion                                String?
  inicio                                     DateTime       @db.Timestamp(6)
  final                                      DateTime       @db.Timestamp(6)
  lugar                                      String?        @db.VarChar(150)
  capacidad                                  Int?
  contacto                                   String?        @db.VarChar(200)
  estado                                     Int?           @db.SmallInt
  estado_evento                              estado_evento? @relation(fields: [estado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_actividad_estado")
  evento_actividad_eventoToevento            evento         @relation("actividad_eventoToevento", fields: [evento], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_actividad_evento")
  asistencia_asistencia_actividadToactividad asistencia[]   @relation("asistencia_actividadToactividad")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
