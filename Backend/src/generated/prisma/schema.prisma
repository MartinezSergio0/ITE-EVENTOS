/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model participantes {
  folio                               String             @id @default(dbgenerated("0")) @db.VarChar(20)
  evento                              Int
  nombre                              String?            @db.VarChar(100)
  genero                              Int?
  fecha_nacimiento                    DateTime?          @db.Date
  correo_electronico                  String?            @db.VarChar(255)
  telefono                            String?            @db.VarChar(10)
  matricula                           String?            @db.VarChar(15)
  institucion                         String?            @db.VarChar(100)
  carrera                             String?            @db.VarChar(100)
  estado                              Int?
  talla_camisa                        String?            @db.VarChar(5)
  comprobante_pago                    String?            @db.VarChar(150)
  participante_num                    Int                @default(autoincrement())
  edad                                Int?               @db.SmallInt
  tipo_participacion                  Int?               @db.SmallInt
  referencia_bancaria                 String?            @unique @db.VarChar(10)
  monto                               Decimal?           @default(1000.00) @db.Decimal(10, 2)
  estado_participantes_estadoToestado estado?            @relation("participantes_estadoToestado", fields: [estado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_participante_estado")
  evento_participantes_eventoToevento evento             @relation("participantes_eventoToevento", fields: [evento], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_participante_evento")
  genero_participantes_generoTogenero genero?            @relation("participantes_generoTogenero", fields: [genero], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_participante_genero")
  tipo_participante                   tipo_participante? @relation(fields: [tipo_participacion], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tipo_participacion")

  @@unique([evento, participante_num])
}

